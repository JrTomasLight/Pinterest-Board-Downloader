{
  "manifest_version": 3,
  "name": "Pinterest Board Downloader",
  "version": "1.4.1",
  "description": "Скачивает доски и отдельные пины Pinterest — картинки и видео — в порядке доски.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting",
    "activeTab",
    "contextMenus",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://*.pinterest.com/*",
    "https://*.pinterest.ca/*",
    "https://*.pinterest.co.uk/*",
    "https://*.pinterest.de/*",
    "https://*.pinterest.fr/*",
    "https://*.pinterest.es/*",
    "https://*.pinterest.it/*",
    "https://*.pinterest.pt/*",
    "https://*.pinterest.ch/*",
    "https://*.pinterest.at/*",
    "https://*.pinterest.se/*",
    "https://*.pinterest.dk/*",
    "https://*.pinterest.ie/*",
    "https://*.pinterest.jp/*",
    "https://*.pinterest.com.au/*",
    "https://*.pinterest.nz/*",
    "https://*.pinterest.com.mx/*",
    "https://*.pinterest.cl/*",
    "https://*.pinterest.ph/*",
    "https://*.pinimg.com/*",
    "https://pin.it/*",
    "https://api.github.com/*",
    "https://github.com/*",
    "https://*.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Скачать доску Pinterest",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.pinterest.com/*",
        "https://*.pinterest.ca/*",
        "https://*.pinterest.co.uk/*",
        "https://*.pinterest.de/*",
        "https://*.pinterest.fr/*",
        "https://*.pinterest.es/*",
        "https://*.pinterest.it/*",
        "https://*.pinterest.pt/*",
        "https://*.pinterest.ch/*",
        "https://*.pinterest.at/*",
        "https://*.pinterest.se/*",
        "https://*.pinterest.dk/*",
        "https://*.pinterest.ie/*",
        "https://*.pinterest.jp/*",
        "https://*.pinterest.com.au/*",
        "https://*.pinterest.nz/*",
        "https://*.pinterest.com.mx/*",
        "https://*.pinterest.cl/*",
        "https://*.pinterest.ph/*"
      ],
      "js": [
        "common.js",
        "pinbutton.js"
      ],
      "run_at": "document_idle"
    }
  ]
}